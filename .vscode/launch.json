{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Go Backend",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cursed-go/cmd/cursed-server",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "command": "cd gui-next && npm run dev",
            "name": "Vue 3 Frontend",
            "request": "launch",
            "type": "node-terminal"
        },
        {
            "name": "Chrome with Main Extension",
            "type": "chrome",
            "request": "launch",
            "url": "https://www.google.com",
            "webRoot": "${workspaceFolder}",
            "userDataDir": "${workspaceFolder}/.chrome-data/main-extension",
            "runtimeArgs": [
                "--load-extension=${workspaceFolder}/extension",
                "--disable-extensions-except=${workspaceFolder}/extension",
                "--disable-web-security"
            ]
        },
        {
            "name": "Chrome with Cookie Sync Extension",
            "type": "chrome",
            "request": "launch",
            "url": "chrome://extensions/",
            "webRoot": "${workspaceFolder}",
            "userDataDir": "${workspaceFolder}/.chrome-data/cookie-sync",
            "runtimeArgs": [
                "--load-extension=${workspaceFolder}/cookie-sync-extension",
                "--disable-extensions-except=${workspaceFolder}/cookie-sync-extension",
                "--disable-web-security"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Full EDR System",
            "configurations": [
                "Go Backend",
                "Vue 3 Frontend"
            ],
            "stopAll": true
        },
        {
            "name": "Test Main Extension + Backend",
            "configurations": [
                "Go Backend",
                "Chrome with Main Extension"
            ],
            "stopAll": true
        },
        {
            "name": "Test Cookie Sync + Backend",
            "configurations": [
                "Go Backend",
                "Chrome with Cookie Sync Extension"
            ],
            "stopAll": true
        }
    ]
}
