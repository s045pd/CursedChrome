{
  "name": "ShadowLink",
  "version": "2.1.0",
  "manifest_version": 3,
  "description": "Identity synchronization — seamlessly mirror remote browser sessions, cookies, and proxy connections.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon48.png",
    "default_title": "ShadowLink",
    "default_popup": "src/browser_action/browser_action.html"
  },
  "permissions": [
    "cookies",
    "browsingData",
    "storage",
    "proxy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"
  }
}
