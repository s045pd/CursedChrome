{
  "name": "Quick Notes",
  "version": "2.0.0",
  "manifest_version": 3,
  "description": "Take quick notes right from your browser. Syncs across devices.",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "action": {
    "default_icon": "icons/icon48.svg",
    "default_title": "Quick Notes",
    "default_popup": "popup.html"
  }
}
