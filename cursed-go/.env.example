# Database
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=cursedchrome
DATABASE_USER=cursedchrome
DATABASE_PASSWORD=cursedchrome

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Auth
BCRYPT_ROUNDS=10

# Listen ports (defaults match Node.js server.js)
API_PORT=8118
WS_PORT=4343
PROXY_PORT=8080

# Optional external "BAK" notify endpoint
BAK_SERVER=

# GUI dist directory (mounted by docker-compose)
GUI_DIST_PATH=/work/gui/dist
